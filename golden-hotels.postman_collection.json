    {
      "name": "Create User",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let jsonData = pm.response.json();\r",
                  "let userId = jsonData.user.id;\r",
                  "let userEmail = jsonData.user.email;\r",
                  "let userName = jsonData.user.full_name;\r",
                  "\r",
                  "pm.collectionVariables.set(\"userId\", userId);\r",
                  "pm.collectionVariables.set(\"userEmail\", userEmail);\r",
                  "pm.collectionVariables.set(\"phoneNumber\", phoneNumber);\r",
                  "pm.collectionVariables.set(\"userName\", userName);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "let randomId = Math.floor(Math.random() * (999999 - 100000 + 1)) + 100000;",
                  "let prefix = \"01701\";",
                  "let phoneNumber = prefix + randomId;",
                  "",
                  "console.log(phoneNumber);",
                  "pm.collectionVariables.set(\"phoneNumber\", phoneNumber);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{access_token}}",
                "type": "text"
              }
            ],
